{
  "name": "@aio/desktop",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Quadrion AI desktop app (Electron main, preload, renderer).",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "guide:pdf": "electron-vite build && node ../../tools/guide/build-pdf.mjs",
    "dist:win": "electron-vite build && node ../../tools/release/dist.mjs --win",
    "dist:config": "node ../../tools/release/brand-config.mjs --print",
    "dist:win:store": "electron-vite build && node ../../tools/release/dist.mjs --win appx",
    "dist:mac": "electron-vite build && node ../../tools/release/dist.mjs --mac"
  },
  "dependencies": {
    "@aio/collab": "workspace:*",
    "@aio/journal": "workspace:*",
    "@aio/merge": "workspace:*",
    "@aio/sync": "workspace:*",
    "@napi-rs/keyring": "^2.1.0",
    "onnxruntime-node": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aio/ai": "workspace:*",
    "@aio/annotate": "workspace:*",
    "@aio/brand": "workspace:*",
    "@aio/change": "workspace:*",
    "@aio/engine": "workspace:*",
    "@aio/geo": "workspace:*",
    "@aio/globe": "workspace:*",
    "@aio/maps": "workspace:*",
    "@aio/modelling": "workspace:*",
    "@aio/pointcloud": "workspace:*",
    "@aio/project": "workspace:*",
    "@aio/schema": "workspace:*",
    "@aio/tiles": "workspace:*",
    "@aio/ui": "workspace:*",
    "@aio/video": "workspace:*",
    "@aio/volumetric": "workspace:*",
    "@aio/workspace": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "pdfjs-dist": "^6.4.299"
  }
}
