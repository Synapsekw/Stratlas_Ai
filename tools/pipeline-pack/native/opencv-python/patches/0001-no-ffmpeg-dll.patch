opencv-python 93 (b83046c) setup.py: on Windows it requires bin/opencv_videoio_ffmpeg*.dll in the
CMake install and fails ("Not found: 'bin/opencv_videoio_ffmpeg\d{3}_64\.dll'") when OpenCV is
built without FFmpeg. Our recipe passes -DWITH_FFMPEG=OFF in CMAKE_ARGS (FFmpeg's LGPL and GPL
codecs are outside our licence policy), so drop that rule then. The native licence gate refuses
any opencv_videoio_ffmpeg file that still reaches a wheel.

diff --git a/setup.py b/setup.py
--- a/setup.py
+++ b/setup.py
@@ -104,7 +104,8 @@ def main():
     rearrange_cmake_output_data = {
         "cv2": (
             [r"bin/opencv_videoio_ffmpeg\d{3}%s\.dll" % ("_64" if is64 else "")]
-            if os.name == "nt"
+            # No FFmpeg plugin DLL in a build without FFmpeg (the pipeline pack's recipe)
+            if os.name == "nt" and "-DWITH_FFMPEG=OFF" not in os.environ.get("CMAKE_ARGS", "")
             else []
         )
         +
