      "why": "LGPL-3.0 (an OpenImageIO feature we keep off)"
    },
    {
      "name": "gmp",
      "why": "LGPL-3.0 or GPL-2.0 (CGAL dependency)"
    },
    {
      "name": "mpfr",
      "why": "LGPL-3.0 (CGAL dependency)"
    },
    {
      "name": "lapack-reference",
      "why": "Brings the gfortran runtime from MSYS2; the build uses CLAPACK (Windows) or Accelerate (macOS)"
    },
    {
      "name": "vcpkg-gfortran",
      "why": "gfortran runtime from MSYS2"
    },
    {
      "name": "qtbase",
      "why": "COLMAP GUI, not built (LGPL-3.0)"
    },
    {
      "name": "cuda",
      "why": "No GPU build in M10 (decision 5)"
    },
    {
      "name": "onnxruntime-gpu",
      "why": "No learned features in M10"
    },
    {
      "name": "curl",
      "why": "No downloads inside COLMAP (DOWNLOAD_ENABLED=OFF)",
      "components": ["colmap"]
    },
    {
      "name": "openssl",
      "why": "No downloads inside COLMAP (DOWNLOAD_ENABLED=OFF)",
      "components": ["colmap"]
    },
    {
      "name": "cryptopp",
      "why": "No downloads inside COLMAP (DOWNLOAD_ENABLED=OFF)",
      "components": ["colmap"]
    }
  ],
  "forbiddenFiles": [
    {
      "pattern": "cholmod|spqr|umfpack",
      "why": "SuiteSparse GPL or LGPL modules"
    },
    {
      "pattern": "^(lib)?(avcodec|avformat|avutil|avdevice|avfilter|swscale|swresample|postproc)([-.]|$)",
      "why": "FFmpeg libraries"
    },
    {
      "pattern": "opencv_videoio_ffmpeg",
      "why": "OpenCV FFmpeg plugin (LGPL); our OpenCV build has none"
    },
    {
      "pattern": "x264|x265|rubberband|vidstab|gnutls",
      "why": "GPL or LGPL media libraries (the PyPI OpenCV macOS wheel bundles them)"
    },
    {
      "pattern": "(^|[^a-z])(cgal|gmp|mpfr)([-.]|$)",
      "why": "CGAL, GMP, MPFR"
    },
    {
      "pattern": "siftgpu",
      "why": "SiftGPU (non-commercial)"
    },
    {
      "pattern": "^(lib)?lsd[-.]",
      "why": "LSD line segment detector (AGPL)"
    }
  ],
