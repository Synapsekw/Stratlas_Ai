{
  "schema": "aio.survey-templates/1",
  "templates": [
    {
      "id": "mining-stockpile",
      "name": "Stockpile (smart base)",
      "family": "polygon",
      "tool": "volume",
      "description": "A stockpile against a TIN of its toe (the smart base). Pick the pile's material for its tonnes.",
      "items": ["net", "area", "perimeter"],
      "fields": [
        {
          "id": "product",
          "name": "Product",
          "type": "text"
        }
      ],
      "comparisons": [
        {
          "label": "Stockpile",
          "from": {
            "kind": "smart"
          },
          "to": {
            "kind": "current"
          },
          "useDeadband": false
        }
      ],
      "style": {
        "color": "#8c6d4f",
        "fillOpacity": 0.15
      },
      "bookmarked": true,
      "set": "mining"
    },
    {
      "id": "mining-bench-volume",
      "name": "Bench volume to reference level",
      "family": "polygon",
      "tool": "volume",
      "description": "Material above a bench's reference level. Type the bench floor level on the base (a typed level); until then the lowest point of the boundary is used.",
      "items": ["net", "area"],
      "fields": [
        {
          "id": "bench",
          "name": "Bench",
          "type": "text"
        },
        {
          "id": "reference-level",
          "name": "Reference level (m)",
          "type": "number"
        }
      ],
      "comparisons": [
        {
          "label": "Above the reference level",
          "from": {
            "kind": "reference",
            "mode": "perimeter-min"
          },
          "to": {
            "kind": "current"
          },
          "useDeadband": false
        }
      ],
      "style": {
        "color": "#8c6d4f",
        "fillOpacity": 0.15
      },
      "bookmarked": true,
      "set": "mining"
    },
