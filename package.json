{
  "name": "quadrion-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "node tools/lint.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --retry=0",
    "test:watch": "vitest",
    "test:e2e": "pnpm -F @aio/desktop test:e2e",
    "dev": "pnpm -F @aio/desktop dev",
    "build": "pnpm -F @aio/desktop build",
    "fixtures": "node tools/fixtures/build.mjs",
    "fixtures:journal": "node packages/schema/src/__fixtures__/journal/generate.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "icons": "node tools/release/icons.mjs && node tools/release/store-assets.mjs",
    "license:check": "node tools/release/license-check.mjs",
    "demo:build": "node tools/demo/build-demo.mjs",
    "demo:check": "node tools/demo/check-no-client-data.mjs && node tools/demo/check-change-demo.mjs",
    "demo:change": "node tools/demo/build-change-demo.mjs",
    "demo:survey": "node tools/demo/survey-demo.mjs",
    "review": "node tools/review-board/server.mjs",
    "test-board": "node tools/test-board/build.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jiti": "2.6.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  }
}
